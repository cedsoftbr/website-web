# Brevo Configuration (Front-end Direct Access)
# WARNING: API Key will be exposed to the client
VITE_BREVO_API_KEY=your_brevo_api_key_here
VITE_BREVO_LIST_ID=2

# Email Notifications
VITE_BREVO_ADMIN_EMAIL=admin@cedsoft.com.br
VITE_BREVO_SENDER_EMAIL=site@cedsoft.com.br
VITE_BREVO_SENDER_NAME=CEDSoft Soluções

# Cloudflare Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key_here
